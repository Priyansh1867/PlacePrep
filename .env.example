# PlacePrep Environment Configuration Template
# Copy this file to .env and fill in your database credentials

# TiDB Cloud / MySQL Database Configuration
MYSQL_URL=jdbc:mysql://gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/placeprep?useSSL=true&requireSSL=true&sslMode=REQUIRED&serverTimezone=UTC
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password
PORT=8082
