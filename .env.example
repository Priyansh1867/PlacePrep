# PlacePrep Environment Configuration Template
# Copy this file to .env and fill in your database credentials

# TiDB Cloud / MySQL Database Configuration
MYSQL_URL=jdbc:mysql://gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/placeprep?useSSL=true&requireSSL=true&sslMode=REQUIRED&serverTimezone=UTC
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password
PORT=8082

# Optional real code execution (disabled by default).
# Add your Judge0 RapidAPI key only to your private backend environment, never commit it.
PLACEPREP_JUDGE0_ENABLED=false
PLACEPREP_JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
PLACEPREP_JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
PLACEPREP_JUDGE0_API_KEY=your_judge0_rapidapi_key
